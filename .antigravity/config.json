{
    "project_name": "vario-gps-ble",
    "default_role": "orchestrator",
    "routing_rules": {
        "orchestrator": {
            "prompt_file": ".antigravity/prompts/orchestrator.md",
            "model": "gemini-3.8-flash",
            "temperature": 0.1,
            "purpose": "Sequential planning, layer boundary enforcement, and checklist validation"
        },
        "architect": {
            "prompt_file": ".antigravity/prompts/architect.md",
            "model": "claude-opus-4.6",
            "fallback_model": "gemini-3.1-pro",
            "temperature": 0.1,
            "purpose": "Static memory layout, layer isolation (common->hal->drivers->middleware->app)"
        },
        "driver_dev": {
            "prompt_file": ".antigravity/prompts/driver_dev.md",
            "model": "claude-sonnet-4.6",
            "fallback_model": "gemini-3.1-pro",
            "temperature": 0.1,
            "purpose": "Bare-metal C++, register manipulation, fixed-point math, functions under 25 lines"
        },
        "tester": {
            "prompt_file": ".antigravity/prompts/tester.md",
            "model": "gemini-3.8-flash",
            "temperature": 0.1,
            "purpose": "Unit testing harness without hardware (mocks, fixed-point validation, circular buffers)"
        },
        "reviewer": {
            "prompt_file": ".antigravity/prompts/reviewer.md",
            "model": "gemini-3.1-pro",
            "temperature": 0.0,
            "purpose": "Strict memory audit, no-float enforcement, no templates/exceptions/RTTI check"
        },
        "doc_writer": {
            "prompt_file": ".antigravity/prompts/doc_writer.md",
            "model": "gemini-3-flash",
            "temperature": 0.2,
            "purpose": "Register maps, wiring diagrams, mathematical documentation and guides"
        }
    }
}
